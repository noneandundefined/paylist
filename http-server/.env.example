# Переменные окружения
# Docker Compose: postgres://postgres:password@db:5432/paylist?sslmode=disable
# Local:          postgres://postgres:password@localhost:5432/paylist?sslmode=disable
DB_ADDR=
SUPER_SECRET_KEY=
IV=

SERVER_BASE_ADDR=

SMTP_EMAIL=
SMTP_ADDR=
SMTP_PORT=
SMTP_EMAIL_PASSWORD=
SMTP_PASSWORD=
CLIENT_URL=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=

# S3 configurations
S3_PATH_STYLE=
S3_VIRTUAL_HOSTED_STYLE=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_USE_SSL=

# Docker Compose: redis
# Local:          localhost
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

POW_DDOS_DIFFICULTY=
POW_DDOS_SECRET=

# Telegram bot for subscription reminders
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional webhook secret path segment; if empty, only polling is used
TELEGRAM_WEBHOOK_SECRET=
# Set to false to disable long polling (e.g. when webhook is configured)
TELEGRAM_POLLING=

# MAX messenger bot for subscription reminders
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
# Optional webhook secret path segment and X-Max-Bot-Api-Secret; if empty, only polling is used
MAX_WEBHOOK_SECRET=
# Optional public webhook URL. If empty and SERVER_BASE_ADDR is http(s), it is built automatically
MAX_WEBHOOK_URL=
# Set to false to disable long polling (e.g. when webhook is configured)
MAX_POLLING=

LOG_DIR="./logs"

GO_ENV=DEV # PROD
