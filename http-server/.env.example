# Local/dev: ./logs  |  Docker prod: /app/logs (host: Clouva.Server/logs)
LOG_DIR=./logs

GO_ENV=DEV # PROD

# Telegram bot for subscription reminders
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional webhook secret path segment for POST /api/v1/telegram/webhook/{secret}
TELEGRAM_WEBHOOK_SECRET=
# Long polling: default true when webhook secret is empty; with webhook secret set, polling is off unless TELEGRAM_POLLING=true
# Set to false if another instance already polls the same bot token (409 conflict)
TELEGRAM_POLLING=true
