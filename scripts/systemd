#!/bin/bash

set -e

# COLORS
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

HOME="$(git rev-parse --show-toplevel)"
GO_VERSION="1.23.0"

SERVICES=(
	nsfw-systemd
	profanity-systemd
	http-systemd-amd64
)

start_service() {
	local service="$1"

	sudo systemctl start "${service}.service"

	if ! sudo systemctl is-active --quiet "${service}.service"; then
		echo -e "${RED}Сервис ${service} не запустился.${NC}" >&2
		sudo journalctl -u "${service}.service" -n 30 --no-pager >&2
		exit 1
	fi

	sudo systemctl status "${service}.service" --no-pager || true
	sudo systemctl enable "${service}.service"
}

for service in "${SERVICES[@]}"; do
	sudo cp "$HOME/.systemd/${service}.service" /etc/systemd/system/
	sudo systemctl stop "${service}.service" || true
done

sudo systemctl daemon-reload

for service in "${SERVICES[@]}"; do
	start_service "$service"
done

echo -e "${GREEN}Success exec systemd services!${NC}"
