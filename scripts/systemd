#!/bin/bash

set -e

# COLORS
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

HOME="$(git rev-parse --show-toplevel)"
GO_VERSION="1.23.0"

sudo cp "$HOME/.systemd/http-systemd-amd64.service" /etc/systemd/system/

sudo systemctl stop http-systemd-amd64.service

sudo systemctl daemon-reload

sudo systemctl start http-systemd-amd64.service

if ! sudo systemctl is-active --quiet http-systemd-amd64.service; then
	echo -e "${RED}Сервис http-systemd-amd64 не запустился.${NC}" >&2
	sudo journalctl -u http-systemd-amd64.service -n 30 --no-pager >&2
	exit 1
fi

sudo systemctl status http-systemd-amd64.service --no-pager || true

sudo systemctl enable http-systemd-amd64.service

echo -e "${GREEN}Success exec systemd services!${NC}"
